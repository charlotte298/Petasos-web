# Copy to .env.local for local dev. In CI these come from GitHub repo *variables* (not secrets):
# all of them end up in the public JS bundle.

# PostHog project API key (phc_…). Leave empty to disable analytics.
VITE_POSTHOG_KEY=
# PostHog US cloud.
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Apps Script web app URL ending in /exec. See docs/forms-setup.md.
VITE_FORMS_ENDPOINT=

# Optional. Base path the site is served from. Defaults to /Petasos-web/ (GitHub Pages project site).
# VITE_BASE=/
